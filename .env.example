# Upstash Redis (free tier) — create a database at https://upstash.com/console
# Copy the REST URL and REST Token from the database settings page.
#
# Local development: copy this file to .env.local and fill in real values.
# Deployment (Vercel): add these two variables in Project Settings → Environment Variables.
#
# If the keys are missing, the app automatically falls back to browser
# localStorage and shows a "Local" status badge instead of "Cloud".

UPSTASH_REDIS_REST_URL=https://your-database-xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token
